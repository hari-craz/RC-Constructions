# Formspree endpoint ID for live contact enquiry submissions
# Replace with your production form ID from https://formspree.io/forms
VITE_FORMSPREE_ID=your_formspree_form_id_here

# Optional: Regional WhatsApp & phone configuration defaults are located in src/content/contact.ts

# Set to true only on Vercel once Web Analytics is enabled in the project dashboard.
# Otherwise /_vercel/insights/script.js returns 403/404 and logs a console error.
VITE_ENABLE_ANALYTICS=false
