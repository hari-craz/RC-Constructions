{
  "name": "rc-constructions",
  "private": true,
  "version": "0.1.0",
  "description": "Single-page scroll-driven architectural construction portfolio",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "knip": "knip",
    "size": "size-limit",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm format:check && pnpm test && pnpm knip && pnpm build",
    "prepare": "husky",
    "docker:build": "docker build -t rc-constructions:latest .",
    "docker:run": "docker run --rm -p 8080:8080 rc-constructions:latest",
    "docker:dev": "docker compose --profile dev up",
    "compare:headers": "node scripts/compare-headers.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:security-txt": "node scripts/check-security-txt.mjs",
    "generate:og": "node scripts/generate-og-image.mjs",
    "generate:favicons": "node scripts/generate-favicons.mjs"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "180 kB"
    }
  ],
  "dependencies": {
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.2.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
